{
  "name": "dashboard-iot-global",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workspaces": "npm run test --workspaces --if-present",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "check:nodash": "node scripts/check-nodash.mjs",
    "extract:logo": "node scripts/extract-logo.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:contrast && npm run check:nodash && npm run test"
  },
  "dependencies": {
    "@dashboard/contract": "*",
    "@dashboard/domain-shared": "*",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "leaflet": "1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
