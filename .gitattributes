# Normalise to LF in the repository, check out native on Windows.
# Without this, every file shows as modified when the repo moves between a
# Windows workstation and a Linux build agent.
* text=auto eol=lf

# Windows-only files that must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary - never diff or convert.
*.png binary
*.jpg binary
*.woff  binary
*.woff2 binary
*.ico binary
