# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env overrides only. .env / .env.mock / .env.production are committed
# on purpose: they hold no secrets, only the mock-vs-http build default.
.env.local
.env.*.local

# The backend server's .env holds REAL InfluxDB/MSSQL credentials - do NOT
# extend the frontend's "commit .env" convention to it. Only .env.example
# (a template with no real values) is committed.
server/.env
server/.env.*
!server/.env.example

# Throwaway Playwright font audit, re-created on demand. Not part of the build.
.tmp-fontaudit.mjs
