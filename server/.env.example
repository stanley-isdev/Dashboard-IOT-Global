# Copy to .env and fill in real values. server/.env* (except this file) is
# gitignored - unlike the frontend's .env files, these hold real credentials.
# `npm run dev` / `npm start` load .env automatically (--env-file-if-exists).

PORT=4000
# Only used when the browser calls the API cross-origin. `npm run dev` proxies
# /api through the Vite dev server (vite.config.ts), so this is not exercised
# in local development - keep it correct for a real deploy anyway.
CORS_ORIGIN=http://localhost:5173

# InfluxDB 3.x (IOx) - HTTP SQL query API, POST {INFLUX_URL}/api/v3/query_sql.
# INFLUX_URL MUST carry the port: a self-hosted InfluxDB 3 listens on 8181 and
# answers on nothing else. No trailing slash.
# Leaving these blank is supported: /meta and /healthz still work, the snapshot
# poller idles, and every source honestly reports `down`.
INFLUX_URL=
INFLUX_DATABASE=
INFLUX_TOKEN=

# Per-query ceiling. The plant-liveness query measures ~40 ms against the live
# instance, so this is a guard against a hung connection, not a normal path.
INFLUX_TIMEOUT_MS=5000

# How often the backend refreshes its InfluxDB snapshot. MUST stay BELOW the
# frontend's refreshMs in public/config/runtime-config.json (3000): the UI
# declares the feed frozen after three identical payloads, so a poller slower
# than the client raises a false alarm on a healthy system.
SNAPSHOT_INTERVAL_MS=2000

# How often the %OA aggregate (Q-03/Q-04) is re-read. 30000 until 2026-08-27,
# which was the lag you could see next to the plant board - it recomputes %OA
# every dashboard refresh, so ours was up to half a minute older. The query
# measures 473-894 ms, so 5 s spends under a fifth of the interval.
OA_REFRESH_MS=5000

# How often the hourly trend (Q-05) is re-read - its own clock. It shared
# OA_REFRESH_MS until 2026-08-27; splitting them is what lets %OA go fast
# without paying for the chart every few seconds. The trend is the dearer query
# (418-1828 ms) and its newest point is an hour-long bucket, so a fast refresh
# cannot visibly change it.
TREND_REFRESH_MS=30000

# MSSQL (BackflushHana_PRD) - scaffolded for future defect queries (D-18).
# Not wired into any route in milestone 1. Leave blank: when unset, MSSQL is
# omitted from meta.sources entirely rather than listed as permanently down,
# which would pin `partial` true and dim the dashboard forever.
MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
