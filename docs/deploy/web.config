<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the built frontend - NOT the topology this repo
  deploys. Kept because it is the whole of the other one.

  The dashboard serves its own dist/ from the Fastify process (STATIC_DIR, see
  server/src/plugins/staticSite.ts), so nothing reads this file today. It is
  here for the deployment that puts IIS in front instead - the reason to want
  that is Windows Authentication or a TLS certificate, both of which IIS gives
  you without touching application code.

  To use it: copy this file into public/, so `npm run build` copies it on to
  dist/ - the folder IIS is pointed at - and clear STATIC_DIR in server/.env so
  the two do not both try to serve the site. Editing it in dist/ instead means
  the next build silently drops your change.

  Requires two IIS extensions, both server-wide, neither installed by default:
    * URL Rewrite 2.1
    * Application Request Routing 3.0, with "Enable proxy" ticked in
      IIS Manager -> (server node) -> Application Request Routing Cache ->
      Server Proxy Settings. Without that tick the API rule below returns
      404.0 and the dashboard shows an empty board with no obvious cause.

  See docs/RUNBOOK.md.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!--
          The API and the SPA are one origin on purpose: runtime-config.json
          ships `apiBaseUrl: "/api/v1"`, so the browser never makes a
          cross-origin call and the backend's CORS_ORIGIN is never exercised.
          Change this and you have to keep CORS_ORIGIN in step by hand.

          MUST stay above the SPA rule - the fallback matches everything, so an
          /api request that reaches it is answered with index.html, i.e. the
          dashboard's own HTML parsed as JSON.

          127.0.0.1, not localhost: on Windows `localhost` resolves to ::1
          first and Fastify's 0.0.0.0 bind is IPv4-only. The mismatch reads
          exactly like a dead backend (502, connection refused).
        -->
        <rule name="API and health proxy" stopProcessing="true">
          <match url="^(api/.*|healthz)$" />
          <action type="Rewrite" url="http://127.0.0.1:4000/{R:0}" />
        </rule>

        <!--
          Client-side routing (react-router). Anything that is not a real file
          or directory on disk is the SPA's problem, not IIS's.
        -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- remove-then-add: IIS already defines these, and a duplicate mimeMap
           is a hard 500.19 at site start. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Not in the IIS defaults, so added without a remove. The build ships
           sourcemaps deliberately (vite.config.ts) and IIS answers 404.3 for
           any extension it has no MIME type for. -->
      <mimeMap fileExtension=".map" mimeType="application/json" />
    </staticContent>

  </system.webServer>

  <!--
    runtime-config.json is the one file edited in place on the server. If it is
    cached, changing apiBaseUrl or grafanaBaseUrl does nothing until the kiosk's
    browser is cleared - which is exactly the kind of change nobody thinks to
    doubt. Same for index.html, which names the current hashed bundles.
  -->
  <location path="config/runtime-config.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Vite hashes every filename under assets/, so these are safe to pin. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
